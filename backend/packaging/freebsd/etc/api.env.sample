# Copy to /usr/local/etc/samba-admin/api.env; do not edit this packaged sample.
SAMBA_ADMIN_HTTP_ADDR=127.0.0.1:8080
SAMBA_ADMIN_DATA_DIR=/var/db/samba-admin
SAMBA_ADMIN_DATABASE=/var/db/samba-admin/samba-admin.db
SAMBA_ADMIN_AGENT_SOCKET=/var/run/samba-admin/samba-admin-agent.sock
SAMBA_ADMIN_AUTH_MODE=local
SAMBA_ADMIN_BOOTSTRAP_USER=admin
SAMBA_ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_SECRET_STORE_VALUE
SAMBA_ADMIN_ADAPTER_MODE=mock
SAMBA_ADMIN_ENABLE_MUTABLE_OPERATIONS=false
SAMBA_ADMIN_ALLOWED_ORIGINS=https://console.example.invalid
SAMBA_ADMIN_SESSION_TTL=8h
SAMBA_ADMIN_REQUEST_TIMEOUT=30s
SAMBA_ADMIN_MAX_BODY_BYTES=2097152
