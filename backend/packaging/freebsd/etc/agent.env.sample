# Copy to /usr/local/etc/samba-admin/agent.env; agent stays disabled by default.
SAMBA_ADMIN_DATA_DIR=/var/db/samba-admin-agent
SAMBA_ADMIN_AGENT_SOCKET=/var/run/samba-admin/samba-admin-agent.sock
SAMBA_ADMIN_AGENT_NONCE_STORE=/var/db/samba-admin-agent/agent-nonces.json
SAMBA_ADMIN_AGENT_NONCE_TTL=5m
SAMBA_ADMIN_AGENT_NONCE_CACHE_LIMIT=4096
SAMBA_ADMIN_AGENT_MAX_MESSAGE_BYTES=1048576
SAMBA_ADMIN_AGENT_MAX_OUTPUT_BYTES=131072
SAMBA_ADMIN_AGENT_MAX_CONCURRENT=4
SAMBA_ADMIN_AGENT_MAX_CLOCK_SKEW=2m
SAMBA_ADMIN_AGENT_SOCKET_MODE=0660
SAMBA_ADMIN_AGENT_SOCKET_OWNER=root
SAMBA_ADMIN_AGENT_SOCKET_GROUP=sambaadmin
# Obtain with: id -u sambaadmin. Placeholder is rejected by rc.d before start.
SAMBA_ADMIN_AGENT_EXPECTED_PEER_UID=REPLACE_WITH_SAMBAADMIN_UID
SAMBA_ADMIN_ADAPTER_MODE=agent
SAMBA_ADMIN_AGENT_EXECUTOR=mock
# Read-only FreeBSD execution requires deliberate enablement and only
# capabilities independently homologated in the target lab.
# SAMBA_ADMIN_AGENT_EXECUTOR=readonly-freebsd
# SAMBA_ADMIN_AGENT_CAPABILITIES=system.inspect,capabilities.inspect,filesystem.inspect,samba.inspect,samba.testparm,domain.member.diagnose,cups.inspect
SAMBA_ADMIN_DEV_SCENARIO=success
