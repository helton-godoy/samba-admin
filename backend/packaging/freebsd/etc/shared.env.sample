# Copy to /usr/local/etc/samba-admin/shared.env with mode 0640 root:sambaadmin.
# The API and agent require the same high-entropy key; it must never enter SQLite.
SAMBA_ADMIN_AGENT_KEY=REPLACE_WITH_32_BYTE_OR_LONGER_SECRET
SAMBA_ADMIN_AGENT_KEY_ID=initial
# Define both values only during a documented rotation window; remove afterward.
# SAMBA_ADMIN_AGENT_PREVIOUS_KEY=REPLACE_WITH_PREVIOUS_SECRET
# SAMBA_ADMIN_AGENT_PREVIOUS_KEY_ID=previous
