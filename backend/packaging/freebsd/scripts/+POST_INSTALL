#!/bin/sh
# Hook pos-instalacao do pkg(8). Cria somente diretorios deste produto.
set -eu

group=sambaadmin
user=sambaadmin

ensure_directory() {
  path=$1
  owner=$2
  directory_group=$3
  mode=$4
  if [ -L "$path" ]; then
    printf 'diretorio recusado por ser symlink: %s\n' "$path" >&2
    exit 1
  fi
  if [ -e "$path" ] && [ ! -d "$path" ]; then
    printf 'caminho existente nao e diretorio: %s\n' "$path" >&2
    exit 1
  fi
  /usr/bin/install -d -o "$owner" -g "$directory_group" -m "$mode" "$path"
  /usr/sbin/chown "$owner:$directory_group" "$path"
  /bin/chmod "$mode" "$path"
}

ensure_directory /var/db/samba-admin "$user" "$group" 0750
ensure_directory /var/db/samba-admin-agent root wheel 0700
ensure_directory /var/log/samba-admin root "$group" 0750
ensure_directory /var/run/samba-admin root "$group" 2750
ensure_directory /usr/local/etc/samba-admin root "$group" 0750

printf '%s\n' 'samba-admin instalado; os servicos permanecem desabilitados ate configuracao explicita.'
