#!/bin/sh
# PROVIDE: samba_admin_agent
# REQUIRE: NETWORKING LOGIN
# BEFORE: samba_admin_api
# KEYWORD: shutdown
#
# Este servico usa NO por padrao. Habilita-lo nao autoriza mutacoes:
# capabilities e feature flags continuam sendo o gate autoritativo.
. /etc/rc.subr

name="samba_admin_agent"
rcvar="samba_admin_agent_enable"
command="/usr/sbin/daemon"
procname="/usr/local/sbin/samba-admin-agent"
pidfile="/var/run/${name}.pid"
required_files="/usr/local/libexec/samba-admin-agent-wrapper"

load_rc_config "$name"

: ${samba_admin_agent_enable:="NO"}
: ${samba_admin_agent_env_file:="/usr/local/etc/samba-admin/agent.env"}
: ${samba_admin_shared_env_file:="/usr/local/etc/samba-admin/shared.env"}
: ${samba_admin_agent_log_file:="/var/log/samba-admin/agent.log"}
: ${samba_admin_agent_run_dir:="/var/run/samba-admin"}

start_precmd="samba_admin_agent_prestart"
command_args="-f -p ${pidfile} -o ${samba_admin_agent_log_file} /usr/local/libexec/samba-admin-agent-wrapper"

samba_admin_agent_prestart()
{
  if [ ! -r "${samba_admin_agent_env_file}" ] || [ ! -r "${samba_admin_shared_env_file}" ]; then
    err 1 "arquivo de ambiente do agente/compartilhado ausente; configure os exemplos com segredos seguros"
  fi
  if /usr/bin/grep -q 'REPLACE_WITH_' "${samba_admin_agent_env_file}" "${samba_admin_shared_env_file}"; then
    err 1 "placeholder de segredo encontrado; inicializacao recusada"
  fi
	if [ -L "${samba_admin_agent_run_dir}" ] || [ ! -d "${samba_admin_agent_run_dir}" ]; then
		err 1 "diretorio do socket ausente ou invalido; reinstale o package antes de iniciar o agente"
	fi
	run_policy=$(/usr/bin/stat -f '%Su:%Sg:%p' "${samba_admin_agent_run_dir}")
	if [ "${run_policy}" != 'root:sambaadmin:42750' ]; then
		err 1 "politica do diretorio do socket invalida: ${run_policy}"
	fi
	if [ -L /var/log/samba-admin ] || [ ! -d /var/log/samba-admin ]; then
		err 1 "diretorio de logs ausente ou invalido; reinstale o package antes de iniciar o agente"
	fi
	log_policy=$(/usr/bin/stat -f '%Su:%Sg:%p' /var/log/samba-admin)
	if [ "${log_policy}" != 'root:sambaadmin:40750' ]; then
		err 1 "politica do diretorio de logs invalida: ${log_policy}"
	fi
  /usr/bin/touch "${samba_admin_agent_log_file}"
  /usr/sbin/chown root:sambaadmin "${samba_admin_agent_log_file}"
  /bin/chmod 0640 "${samba_admin_agent_log_file}"
}

run_rc_command "$1"
