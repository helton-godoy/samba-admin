FROM golang:1.26-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libsqlite3-dev libargon2-dev ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . .
ENV SAMBA_ADMIN_HTTP_ADDR=:8080 SAMBA_ADMIN_AUTH_MODE=development-bypass SAMBA_ADMIN_ADAPTER_MODE=mock
EXPOSE 8080
CMD ["go", "run", "./cmd/samba-admin-api"]
