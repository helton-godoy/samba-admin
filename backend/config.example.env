SAMBA_ADMIN_HTTP_ADDR=127.0.0.1:8080
SAMBA_ADMIN_DATA_DIR=./var
SAMBA_ADMIN_DATABASE=./var/samba-admin.db
# Produção: use diretório dedicado, por exemplo /var/run/samba-admin/samba-admin-agent.sock.
SAMBA_ADMIN_AGENT_SOCKET=./var/samba-admin-agent.sock
SAMBA_ADMIN_AGENT_KEY=troque-por-chave-aleatoria-de-no-minimo-32-bytes
SAMBA_ADMIN_AGENT_KEY_ID=current
# Defina somente durante a janela de rotação; remova ao final.
# SAMBA_ADMIN_AGENT_PREVIOUS_KEY=
# SAMBA_ADMIN_AGENT_PREVIOUS_KEY_ID=previous
SAMBA_ADMIN_AGENT_NONCE_STORE=./var/agent-nonces.json
SAMBA_ADMIN_AGENT_NONCE_TTL=5m
SAMBA_ADMIN_AGENT_NONCE_CACHE_LIMIT=4096
SAMBA_ADMIN_AGENT_MAX_MESSAGE_BYTES=1048576
SAMBA_ADMIN_AGENT_MAX_OUTPUT_BYTES=131072
SAMBA_ADMIN_AGENT_MAX_CONCURRENT=4
SAMBA_ADMIN_AGENT_MAX_CLOCK_SKEW=2m
SAMBA_ADMIN_AGENT_SOCKET_MODE=0660
# Em FreeBSD com executor real, configure root, grupo sambaadmin e o UID do processo API.
# SAMBA_ADMIN_AGENT_SOCKET_OWNER=root
# SAMBA_ADMIN_AGENT_SOCKET_GROUP=sambaadmin
# SAMBA_ADMIN_AGENT_EXPECTED_PEER_UID=1001
SAMBA_ADMIN_AGENT_EXECUTOR=mock
# Para readonly-freebsd, informe apenas capabilities homologadas, separadas por virgula.
# SAMBA_ADMIN_AGENT_CAPABILITIES=system.inspect,capabilities.inspect,filesystem.inspect,samba.inspect,samba.testparm,domain.member.diagnose,cups.inspect
SAMBA_ADMIN_ADAPTER_MODE=mock
# Obrigatório somente quando SAMBA_ADMIN_ADAPTER_MODE=fixture.
# SAMBA_ADMIN_FIXTURE_PATH=./fixtures/freebsd-sanitized.json
SAMBA_ADMIN_AUTH_MODE=development-bypass
SAMBA_ADMIN_ALLOWED_ORIGINS=http://localhost:5173
SAMBA_ADMIN_SESSION_TTL=8h
SAMBA_ADMIN_REQUEST_TIMEOUT=30s
SAMBA_ADMIN_MAX_BODY_BYTES=2097152
SAMBA_ADMIN_DEV_SCENARIO=success
SAMBA_ADMIN_ENABLE_MUTABLE_OPERATIONS=false
# Base64 de exatamente 32 bytes para criptografia de segredos MFA.
# SAMBA_ADMIN_TOTP_ENCRYPTION_KEY=
# SAMBA_ADMIN_MFA_REQUIRED_ROLES=administrador do sistema
# Produção/local-auth no primeiro start:
# SAMBA_ADMIN_AUTH_MODE=local
# SAMBA_ADMIN_BOOTSTRAP_USER=admin
# SAMBA_ADMIN_BOOTSTRAP_PASSWORD=defina-em-secret-store
