{
  "name": "samba-admin-freebsd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:openapi": "openapi-typescript ../backend/api/openapi.yaml -o src/api/generated/openapi.ts",
    "openapi:validate": "redocly lint ../backend/api/openapi.yaml",
    "check-generated": "npm run generate:openapi && git diff --exit-code -- src/api/generated/openapi.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "^7.7.1",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@redocly/cli": "^1.34.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "browserslist": "^4.28.6",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "openapi-typescript": "^7.8.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
